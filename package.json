{
  "name": "bordeaux-wine-academy",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Interactive Bordeaux Wine Education Platform",
  "keywords": [
    "wine",
    "bordeaux",
    "education",
    "interactive",
    "mapping"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && npx vite-plugin-gh-pages",
    "climate:italy": "node scripts/build-italy-climate.mjs",
    "climate:italy:dry": "node scripts/build-italy-climate.mjs --dry-run",
    "media:scan": "node scripts/media-optimize.mjs --scan",
    "media:optimize": "node scripts/media-optimize.mjs --apply",
    "i18n:translate": "node scripts/translate-locales.mjs",
    "i18n:translate:dry": "node scripts/translate-locales.mjs --dry-run",
    "i18n:translate:force": "node scripts/translate-locales.mjs --force",
    "lessons:extract": "node scripts/extract-lesson-i18n.mjs",
    "lessons:extract:dry": "node scripts/extract-lesson-i18n.mjs --dry-run",
    "lessons:translate": "node scripts/translate-lessons.mjs",
    "lessons:translate:dry": "node scripts/translate-lessons.mjs --dry-run",
    "lessons:translate:force": "node scripts/translate-lessons.mjs --force"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.101.1",
    "html2canvas": "^1.4.1",
    "html2pdf.js": "^0.12.1",
    "leaflet": "^1.9.4",
    "mapbox-gl": "^2.15.0",
    "pinia": "^2.3.1",
    "proj4": "^2.20.8",
    "stripe": "^16.12.0",
    "vue": "^3.5.18",
    "vue-draggable-next": "^2.3.0",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@turf/turf": "^7.3.4",
    "@types/mapbox-gl": "^2.7.21",
    "@vitejs/plugin-vue": "^4.x",
    "ffmpeg-static": "^5.2.0",
    "sass": "^1.93.2",
    "shapefile": "^0.6.6",
    "sharp": "^0.33.5",
    "supabase": "^2.85.0",
    "vite": "^4.x"
  },
  "vite": {
    "plugins": [
      "@vitejs/plugin-vue"
    ],
    "server": {
      "port": 5173,
      "open": true
    },
    "build": {
      "sourcemap": true,
      "chunkSizeWarningLimit": 1000
    }
  }
}
