// 8個村莊AOC的geojson路徑
const geojsonPaths = ref([
  '/geojson/LeftBank/Medoc/Margaux_AOC.geojson',
  '/geojson/LeftBank/Medoc/Pauillac_AOC.geojson',
  '/geojson/LeftBank/Medoc/St-Julien_AOC.geojson',
  '/geojson/LeftBank/Medoc/St-Estephe_AOC.geojson',
