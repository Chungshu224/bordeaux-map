<template>
  <div class="medoc-interactive-map-container">
    <PresentationMap
      :mapFocus="mapFocus"
      :geojsonPaths="geojsonPaths"
      :showBordeaux="false"
      :key="mapKey"
      @mapReady="handleMapReady"
    />
