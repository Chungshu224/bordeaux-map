{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "installCommand": "npm install",
  "devCommand": "npm run dev",
  "rewrites": [
    {
      "source": "/ispra/:path*",
      "destination": "https://sgi2.isprambiente.it/:path*"
    },
    {
      "source": "/brgm/:path*",
      "destination": "https://geoservices.brgm.fr/:path*"
    },
    {
      "source": "/igme/:path*",
      "destination": "https://mapas.igme.es/:path*"
    },
    {
      "source": "/bgr/:path*",
      "destination": "https://services.bgr.de/:path*"
    },
    {
      "source": "/hugeo/:path*",
      "destination": "https://map.hugeo.hu/:path*"
    },
    {
      "source": "/asris/:path*",
      "destination": "https://www.asris.csiro.au/:path*"
    },
    {
      "source": "/lneg/:path*",
      "destination": "https://sig.lneg.pt/:path*"
    },
    {
      "source": "/gnsgeo/:path*",
      "destination": "https://data.gns.cri.nz/:path*"
    },
    {
      "source": "/cgs/:path*",
      "destination": "https://maps.conservation.ca.gov/:path*"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/|geojson/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
