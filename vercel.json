{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "installCommand": "npm install",
  "devCommand": "npm run dev",
  "rewrites": [
    {
      "source": "/ispra/:path*",
      "destination": "https://sgi2.isprambiente.it/:path*"
    },
    {
      "source": "/brgm/:path*",
      "destination": "https://geoservices.brgm.fr/:path*"
    },
    {
      "source": "/igme/:path*",
      "destination": "https://mapas.igme.es/:path*"
    },
    {
      "source": "/bgr/:path*",
      "destination": "https://services.bgr.de/:path*"
    },
    {
      "source": "/hugeo/:path*",
      "destination": "https://map.hugeo.hu/:path*"
    },
    {
      "source": "/asris/:path*",
      "destination": "https://www.asris.csiro.au/:path*"
    },
    {
      "source": "/lneg/:path*",
      "destination": "https://sig.lneg.pt/:path*"
    },
    {
      "source": "/gnsgeo/:path*",
      "destination": "https://data.gns.cri.nz/:path*"
    },
    {
      "source": "/cgs/:path*",
      "destination": "https://maps.conservation.ca.gov/:path*"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/|geojson/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' cdn.jsdelivr.net blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.mapbox.com; connect-src 'self' https://api.mapbox.com https://*.tiles.mapbox.com https://events.mapbox.com https://ayyrxnaigvzqktkswhnd.supabase.co wss://ayyrxnaigvzqktkswhnd.supabase.co; worker-src blob:; font-src 'self' data:; form-action 'self' https://payment.ecpay.com.tw https://payment-stage.ecpay.com.tw; object-src 'none'; frame-ancestors 'none';"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
