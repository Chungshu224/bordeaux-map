# Copy this file to .env and set your Mapbox token
# Windows PowerShell: cp .env.example .env
## Mapbox token setup (local only)
# 建議將本檔案內容複製到「.env.local」，並在本機填入你的 Mapbox public token（以 pk. 開頭）
# Windows PowerShell：
#   cp .env.example .env.local
#   之後編輯 .env.local，將下方佔位字串換成你的 token

# Mapbox public token（pk. 開頭）
# 將下方佔位字串替換為你的 public Mapbox token（不要把真實金鑰推上 Git）
VITE_MAPBOX_TOKEN=YOUR_MAPBOX_TOKEN_HERE

# ECPay serverless API（Vercel / 本機都可用）
# 測試環境可先用：
#   ECPAY_MERCHANT_ID=3002607
#   ECPAY_HASH_KEY=pwFHCqoQZGmho4w6
#   ECPAY_HASH_IV=EkRm7iFT261dpevs
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=
ECPAY_RETURN_URL=https://your-domain.com/api/ecpay-callback
ECPAY_ORDER_RESULT_URL=https://your-domain.com/api/ecpay-order-result
ECPAY_STAGE=true

# Supabase（ECPay 訂單建立 / 回呼寫入需要）
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 若你有設定 Token 的 Allowed URLs，請加入：
#   http://localhost:5173/*
#   http://localhost:5174/*
# 以避免本地開發遭到 401/403 阻擋。
